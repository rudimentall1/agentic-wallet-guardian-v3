# Copy to .env and adjust. Nothing here is required to run Guardian in
# zero-config demo mode (mock providers, in-memory storage, no auth) -
# these only matter once you want a real self-hosted deployment.

# --- Data providers -----------------------------------------------------
# "mock" (default, zero-config) or a real provider per source.
GUARDIAN_WALLET_PROVIDER=mock          # mock | rpc
GUARDIAN_CONTRACT_PROVIDER=mock        # mock | blockscout | goplus
GUARDIAN_TOKEN_PROVIDER=mock           # mock | dexscreener | goplus
GUARDIAN_SIMULATION_PROVIDER=null      # null | rpc (real eth_call dry-run; needs calldata in intent.metadata)
GUARDIAN_TX_BUILDER=null               # null | rpc (builds real calldata for transfer/approve intents so simulation has something to dry-run)

# Required only if GUARDIAN_WALLET_PROVIDER=rpc. One per chain you use -
# your own node, or a provider you trust (Alchemy/Infura/QuickNode/a
# public endpoint from chainlist.org). No default is baked in on purpose.
# GUARDIAN_RPC_ETHEREUM=https://your-node-or-provider
# GUARDIAN_RPC_BASE=https://your-node-or-provider
# GUARDIAN_RPC_ARBITRUM=https://your-node-or-provider
# GUARDIAN_RPC_POLYGON=https://your-node-or-provider
# GUARDIAN_RPC_BOTCHAIN=https://rpc.botchain.ai  # chain ID 677, EVM-compatible, confirmed by BOT Chain's team

# Wallet-age estimation via binary search over historical state - needs
# an archive-capable RPC endpoint, off by default (see providers.py docstring).
GUARDIAN_RPC_ESTIMATE_AGE=false

# Used when GUARDIAN_CONTRACT_PROVIDER=blockscout / GUARDIAN_TOKEN_PROVIDER=dexscreener.
GUARDIAN_BLOCKSCOUT_BASE_URL=https://eth.blockscout.com
GUARDIAN_DEXSCREENER_BASE_URL=https://api.dexscreener.com

# Used when GUARDIAN_CONTRACT_PROVIDER=goplus / GUARDIAN_TOKEN_PROVIDER=goplus.
# Optional - works keyless at a lower rate limit. Get one from GoPlus's
# Access Token API if you need more: https://docs.gopluslabs.io/reference/getaccesstokenusingpost
# GOPLUS_API_KEY=your-access-token
GUARDIAN_PROVIDER_TIMEOUT_SECONDS=5

# --- Storage -------------------------------------------------------------
GUARDIAN_STORAGE_BACKEND=memory        # memory | sqlite
GUARDIAN_SQLITE_PATH=data/guardian.db

# --- Local threat / contract lists (see data/threat_lists/README.md) ----
GUARDIAN_SANCTIONED_LIST_PATH=data/threat_lists/sanctioned_addresses.json
GUARDIAN_MALICIOUS_CONTRACTS_PATH=data/threat_lists/malicious_contracts.json
GUARDIAN_VERIFIED_CONTRACTS_PATH=data/threat_lists/verified_contracts.json

# --- API security ---------------------------------------------------------
# Unset = no auth (fine for local dev only). Set before exposing this
# instance beyond localhost.
# GUARDIAN_API_KEY=change-me-to-a-long-random-value
GUARDIAN_RATE_LIMIT_PER_MINUTE=60
